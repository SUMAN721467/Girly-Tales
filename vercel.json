{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/supabase-proxy/:path*",
      "destination": "https://luidwbslkwzkdetodqte.supabase.co/:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|supabase-proxy/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
