# ==============================================================================
# GIRLY TALES - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / CLIENT-SAFE (Vite bundles these into browser code)
# ------------------------------------------------------------------------------
# Supabase Project URL (Public)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Keys (Use anon key or publishable key ONLY; NEVER service-role)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Authorized Admin Emails for Admin Dashboard Access (comma-separated)
VITE_ADMIN_EMAILS=admin@girlytales.in,your-email@example.com

# Razorpay Public Key (Client Checkout Modal)
VITE_RAZORPAY_KEY_ID=rzp_test_...

# Google Analytics 4 Measurement ID
VITE_GA_MEASUREMENT_ID=G-GVLLCWHFP5

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Vercel Serverless Functions / Node / Local Dev Backend)
# WARNING: NEVER prefix these with VITE_ ! They must NEVER reach the browser.
# ------------------------------------------------------------------------------
# Resend Email API Key (Used strictly in /api/send-email serverless function)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=admin@girlytales.in

# Razorpay Secret Key (Used strictly in /api/create-order & /api/verify-payment)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Supabase Service Role Key (OPTIONAL - Server-side scripts/cron ONLY, NEVER on client)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
